# Copy to .env on the VPS and fill in real values.
# docker compose reads this file automatically via env_file.

PORT=3000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/learning-event?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
STAFF_PASSWORD=replace-with-a-strong-password
PAYSTACK_SECRET_KEY=
